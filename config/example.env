# Copy to config/local.env on the licensed Linux host. This is Bash syntax.
# Load the site's license/tool environment here, or before running make.
# source /path/to/site/environment.sh
# module load <site-license-module> <site-xcelium-module>
# export PATH="/path/to/genus/bin:/path/to/innovus/bin:$PATH"
export TECH_DIR="/path/to/GPDK045"
# Gate-level simulation requires the site's Verilog standard-cell models.
export CELL_MODELS="/path/to/standard_cells.v"
# Optional vendor SDF workaround. Leave unset unless required by the tool version.
# export SDF_WORKAROUND="/path/to/vendor/sdf_width_wa.etf"
# export period_clk=4.000
